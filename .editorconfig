# EditorConfig — https://editorconfig.org
# Project: contributing-clanker (mostly bash + markdown)

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{yml,yaml,json}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.{js,jsx,ts,tsx,css,scss,html}]
indent_size = 2

[*.go]
indent_style = tab

[*.rs]
indent_size = 4
